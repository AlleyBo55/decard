# Optional. Helius becomes the primary Solana RPC (activity history via getTransactionsForAddress,
# current holders on bids). Without it, or whenever Helius is throttled/out of credits/down, the app
# falls back to the keyless public RPC. Free key at https://dashboard.helius.dev.
# Server-only: never prefix it with NEXT_PUBLIC_. Locally put it in .env; on Vercel add it under
# Project Settings → Environment Variables.
HELIUS_API_KEY=

# Optional. Raises Collector Crypt rate limits 10x. Request at support@collectorcrypt.com. Server-only.
CC_API_KEY=
# Optional. The private Slabz backend behind /rip (github.com/AlleyBo55/decard-backend). Server-only.
# DECARDBE_SECRET must equal decardbe's INTERNAL_API_SECRET. Unset leaves /rip offline.
# Locally: DECARDBE_URL=http://127.0.0.1:8080. On Lighthouse the deploy writes http://decardbe:8080.
DECARDBE_URL=
DECARDBE_SECRET=

# Recommended in production. The canonical origin for SEO tags, robots.txt and sitemap.xml,
# e.g. https://www.decard.fun. On Vercel it otherwise falls back to the production domain.
NEXT_PUBLIC_SITE_URL=

# Optional. Google Analytics 4 measurement ID (G-XXXXXXXXXX). Public by design; unset loads no analytics.
NEXT_PUBLIC_GA_ID=
