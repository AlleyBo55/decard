# Optional. Helius becomes the primary Solana RPC (activity history via getTransactionsForAddress,
# current holders on bids). Without it, or whenever Helius is throttled/out of credits/down, the app
# falls back to the keyless public RPC. Free key at https://dashboard.helius.dev.
# Server-only: never prefix it with NEXT_PUBLIC_. Locally put it in .env; on Vercel add it under
# Project Settings → Environment Variables.
HELIUS_API_KEY=

# Optional. Raises Collector Crypt rate limits 10x. Request at support@collectorcrypt.com. Server-only.
CC_API_KEY=
